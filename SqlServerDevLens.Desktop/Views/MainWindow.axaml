<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlServerDevLens.Desktop.ViewModels"
        xmlns:runtime="using:SqlServerDevLens.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="880" d:DesignHeight="680"
        x:Class="SqlServerDevLens.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SQL Server DevLens MCP"
        Icon="/Assets/devlens-owl.ico"
        Width="880" Height="680"
        MinWidth="680" MinHeight="570"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="#0B1220">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="790" HorizontalAlignment="Center"
                Margin="32" Padding="0">
            <StackPanel Spacing="24">
                <!-- App identity -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Image Width="64" Height="64"
                           Source="/Assets/devlens-owl.png"
                           Stretch="Uniform"
                           ToolTip.Tip="DevLens Owl" />
                    <StackPanel Grid.Column="1" Spacing="5"
                                VerticalAlignment="Center">
                        <TextBlock Text="SQL Server DevLens MCP"
                                   FontSize="27" FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="Your SQL Server, understood by AI."
                                   FontSize="14" Foreground="#94A3B8" />
                    </StackPanel>
                </Grid>

                <Border Background="#111C30" BorderBrush="#2B3B54"
                        BorderThickness="1" CornerRadius="18" Padding="30">
                    <Grid>
                    <StackPanel IsVisible="{Binding IsChoosingMode}" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Choose your operating mode"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="Start with SQL exploration, or enable API testing features alongside it."
                                       FontSize="14" Foreground="#A9B8CE"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="14">
                            <Border Background="#192941" BorderBrush="#375578"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="18">
                                <RadioButton GroupName="OperatingMode"
                                             IsChecked="{Binding IsSqlOnlySelected, Mode=TwoWay}"
                                             VerticalAlignment="Center">
                                    <StackPanel Margin="12,0,0,0" Spacing="7">
                                        <TextBlock Text="SQL Server Only"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                        <TextBlock Text="Inspect schemas, tables, keys, relationships, stored procedures and permitted data."
                                                   FontSize="13" Foreground="#A9B8CE"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="No Postman installation required"
                                                   FontSize="12" Foreground="#7DD3FC" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border Background="#192941" BorderBrush="#375578"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="18">
                                <RadioButton GroupName="OperatingMode"
                                             IsChecked="{Binding IsSqlWithPostmanSelected, Mode=TwoWay}"
                                             VerticalAlignment="Center">
                                    <StackPanel Margin="12,0,0,0" Spacing="7">
                                        <TextBlock Text="SQL Server + Postman"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                        <TextBlock Text="Explore SQL Server, manage API requests and validate API responses against database results."
                                                   FontSize="13" Foreground="#A9B8CE"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="Optional integration for API testing"
                                                   FontSize="12" Foreground="#7DD3FC" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>

                        <Button Content="Continue"
                                Command="{Binding ContinueCommand}"
                                Background="#2563EB" Foreground="White"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="15" FontWeight="SemiBold"
                                Padding="18,13" />
                        <TextBlock Text="Developed with the assistance of ChatGPT and OpenAI. Thank you for helping bring DevLens to life."
                                   FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsConnectionStepVisible}" Spacing="16">
                        <TextBlock Text="Connect to SQL Server" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedModeLabel}" Foreground="#7DD3FC" />
                        <TextBlock Text="SQL Server + Postman continues to Postman setup after a successful SQL test. SQL Server Only starts the server directly." TextWrapping="Wrap" />
                        <StackPanel DataContext="{Binding Connection}" x:DataType="vm:ConnectionViewModel" Spacing="10">
                            <StackPanel IsEnabled="{Binding IsEditable}" Spacing="10">
                                <TextBlock Text="Server / host (TCP)" />
                                <TextBox Text="{Binding Host}" PlaceholderText="localhost or server.example.com" />
                                <TextBlock Text="Port" />
                                <TextBox Text="{Binding Port}" />
                                <TextBlock Text="Database (required, one database)" />
                                <TextBox Text="{Binding Database}" />
                                <CheckBox Content="Windows authentication (current OS identity)" IsChecked="{Binding WindowsAuthentication}" />
                                <TextBlock Text="Otherwise use SQL Server authentication. Windows auth on macOS/Linux requires Kerberos configuration." TextWrapping="Wrap" FontSize="12" />
                                <StackPanel IsVisible="{Binding IsSqlAuthentication}" Spacing="10">
                                    <TextBlock Text="SQL username" />
                                    <TextBox Text="{Binding Username}" />
                                    <TextBlock Text="Password" />
                                    <TextBox Text="{Binding Password}" PasswordChar="●" />
                                </StackPanel>
                                <CheckBox Content="Encrypt connection" IsChecked="{Binding Encrypt}" />
                                <CheckBox Content="Trust server certificate (skips certificate validation)" IsChecked="{Binding TrustServerCertificate}" />
                                <CheckBox Content="Remember profile after a successful test (no password)" IsChecked="{Binding RememberProfile}" />
                                <CheckBox Content="Remember password securely" IsChecked="{Binding RememberPassword}" IsEnabled="{Binding CanRememberPassword}" />
                                <TextBlock Text="{Binding PasswordStorageHint}" TextWrapping="Wrap" FontSize="12" />
                                <Button Content="Forget saved profile" Command="{Binding ForgetProfileCommand}" />
                                <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Background="#2563EB" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#7DD3FC" />
                        </StackPanel>
                        <Button Content="Back to mode selection" Command="{Binding BackCommand}" IsEnabled="{Binding Connection.IsEditable}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsPostmanStepVisible}" Spacing="16">
                        <TextBlock Text="Connect to Postman" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="SQL test succeeded and the connection was closed. Select a Postman workspace and collection to continue." TextWrapping="Wrap" Foreground="#7DD3FC" />
                        <StackPanel DataContext="{Binding Postman}" x:DataType="vm:PostmanViewModel" Spacing="12">
                            <StackPanel IsEnabled="{Binding IsEditable}" Spacing="12">
                                <TextBlock Text="Postman API key" />
                                <TextBox Text="{Binding ApiKey}" PasswordChar="●" PlaceholderText="Enter your Postman API key locally" />
                                <CheckBox Content="Remember API key securely" IsChecked="{Binding RememberKey}" IsEnabled="{Binding CanRememberKey}" />
                                <TextBlock Text="{Binding StorageHint}" TextWrapping="Wrap" FontSize="12" />
                                <Button Content="Forget saved key" Command="{Binding ForgetKeyCommand}" />
                                <Button Content="Load Workspaces" Command="{Binding LoadWorkspacesCommand}" Background="#2563EB" />
                                <TextBlock Text="Workspace (name and ID)" />
                                <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" HorizontalAlignment="Stretch" />
                                <Button Content="Load Collections" Command="{Binding LoadCollectionsCommand}" Background="#2563EB" />
                                <TextBlock Text="Collection (name and ID)" />
                                <ComboBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" HorizontalAlignment="Stretch" />
                                <Button Content="Start MCP Server" Command="{Binding StartCommand}" Background="#2563EB" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="#7DD3FC" TextWrapping="Wrap" />
                            <TextBlock Text="Setup reads metadata only. Later folder/request changes and HTTP runs require a separate DevLens approval. Known secrets are masked in reviews and chat output. Scripts, environments, Vault and uploads are unsupported." TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <Button Content="Back to SQL connection" Command="{Binding BackFromPostmanCommand}" IsEnabled="{Binding Postman.IsEditable}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsServerStepVisible}" Spacing="18">
                        <TextBlock Text="MCP server" FontSize="26" FontWeight="Bold" />
                        <Grid x:Name="ServerColumns" ColumnDefinitions="*,*" ColumnSpacing="20">
                        <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" RowSpacing="16">
                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding Server}" x:DataType="vm:ServerViewModel" Spacing="16">
                            <TextBlock Text="{Binding Status}" FontSize="18" Foreground="#7DD3FC" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConnectionNotice}" TextWrapping="Wrap" FontSize="12" />
                            <Border BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Automatic authorization — this session only" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Checked actions skip the approval dialog. Procedures and HTTP requests may change or delete data. Only enable categories you intend to delegate. Unchecking invalidates unused automatic approvals; already started actions cannot be undone. All boxes reset on Stop/restart." FontSize="12" TextWrapping="Wrap" Foreground="#FBBF24" />
                                    <CheckBox Content="Execute stored procedures" IsChecked="{Binding AutoProcedureExecution}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Create stored procedures" IsChecked="{Binding AutoProcedureCreate}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Modify stored procedures" IsChecked="{Binding AutoProcedureAlter}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Create tables" IsChecked="{Binding AutoTableCreate}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Modify table structure" IsChecked="{Binding AutoTableAlter}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="INSERT table rows" IsChecked="{Binding AutoInsert}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="UPDATE table rows" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="DELETE table rows (WHERE required)" IsChecked="{Binding AutoDelete}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Run Postman HTTP requests" IsChecked="{Binding AutoPostmanRun}" IsEnabled="{Binding IsRunning}" />
                                    <CheckBox Content="Create/edit Postman requests or folders" IsChecked="{Binding AutoPostmanChange}" IsEnabled="{Binding IsRunning}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="SQL exploration and procedure tools are available for this database. Actions require review and manual approval unless enabled for this session. INSERT, UPDATE and DELETE remain transactional and scoped. Table data actions use a transaction and row limit. Private schema backups do not back up table rows. Each operation opens and closes its own connection." TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PostmanSummary}" TextWrapping="Wrap" Foreground="#7DD3FC" />
                            <TextBlock Text="Keep this window open. Enable the updated DevLens local plugin to connect. Discovery and chat clients can connect simultaneously (up to 16 sessions). Stop closes desktop sessions. With the updated plugin, the status tool stays available and reconnects automatically on the next call after DevLens starts again." TextWrapping="Wrap" />


                        </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="1" Content="Stop MCP server" Click="StopServer_Click" IsEnabled="{Binding Server.CanStop}" Background="#B91C1C" Foreground="White" />
                        <Button Grid.Row="2" Content="Back to connection setup" Command="{Binding ReturnToConnectionCommand}" IsEnabled="{Binding Server.CanReturn}" />
                        </Grid>
                        <Border Grid.Column="1" Background="#0B1220" BorderBrush="#2B3C55" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                <TextBlock Text="Activity log" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Latest first · last 200 events this session. Completed means the tool call finished; approval and saving are separate steps." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                <ScrollViewer x:Name="ActivityScroll" Grid.Row="2" Height="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Server.ActivityEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="runtime:ServerActivity">
                                                <Border BorderBrush="#2B3C55" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding State}" Foreground="#7DD3FC" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontSize="11" Foreground="#94A3B8" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Operation}" TextWrapping="Wrap" FontSize="12" />
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        </Grid>
                    </StackPanel>
                    </Grid>
                </Border>

                <Button Content="Help: connect to ChatGPT Desktop" Click="Help_Click" HorizontalAlignment="Center" />
                <TextBlock Text="Open source · .NET 10 · Avalonia UI · MCP integration in development"
                           FontSize="12" Foreground="#7C8BA3"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
