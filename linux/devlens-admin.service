[Unit]
Description=DevLens Linux Administration Portal (SSH-forwarded loopback only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/devlens
LoadCredential=admin-token:/etc/devlens-admin/admin-token
ExecStart=/opt/devlens/admin/SqlServerDevLens.Admin
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/devlens /var/lib
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
