[Unit]
Description=DevLens read-only MCP tunnel instance %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=devlens-%i
Group=devlens-%i
LoadCredential=sql-password:/etc/devlens/%i/sql-password
LoadCredential=tunnel-key:/etc/devlens/%i/tunnel-key
ExecStart=/opt/devlens/linux/start-tunnel.sh %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devlens-%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
